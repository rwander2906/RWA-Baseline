{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rwa://schemas/ai-review-package-v1",
  "title": "RWA AI Review Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "head_sha",
        "base_ref"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 7
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "body",
        "acceptance_criteria"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diff": {
      "type": "string",
      "minLength": 1
    },
    "baseline_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "project_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  }
}
